{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QMC Decoder",
  "version": "1.3.0",
  "identifier": "com.ownlight6.qmc-decoder",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "QMC Decoder",
        "width": 840,
        "height": 760,
        "minWidth": 560,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Decrypt QQ Music encrypted audio files",
    "longDescription": "Decrypt QQ Music QMC1/QMC2 encrypted audio files",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}